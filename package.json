{
  "name": "gitledger-cli",
  "version": "0.1.0",
  "description": "Official CLI for GitLedger workflows",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitledger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "gitledger",
    "cli",
    "typescript",
    "oss"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
